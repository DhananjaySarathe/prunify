{
  "name": "prunify",
  "version": "0.1.9",
  "description": "CLI tool for codebase analysis: dead code, duplicates, circular deps, and health reports",
  "type": "module",
  "bin": {
    "prunify": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dead-code",
    "unused-code",
    "code-cleanup",
    "typescript",
    "refactor",
    "linter"
  ],
  "author": "Dhananjay Sarathe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DhananjaySarathe/prunify.git"
  },
  "homepage": "https://github.com/DhananjaySarathe/prunify#readme",
  "bugs": {
    "url": "https://github.com/DhananjaySarathe/prunify/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "minimatch": "^10.2.5",
    "ora": "^8.1.1",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
